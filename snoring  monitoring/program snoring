#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <driver/i2s.h>

// ======================================================
// OLED SSD1306
// ======================================================

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// ======================================================
// PIN I2S INMP441 (ESP32-C3)
// ======================================================

#define I2S_WS   0
#define I2S_SD   2
#define I2S_SCK  1

#define I2S_PORT I2S_NUM_0
#define bufferLen 64

int32_t sBuffer[bufferLen];

// ======================================================
// FILTER
// ======================================================

float filteredLevel = 0;

// ======================================================
// I2S SETUP
// ======================================================

void i2s_install() {

  const i2s_config_t i2s_config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate = 16000,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_32BIT,
    .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 8,
    .dma_buf_len = bufferLen,
    .use_apll = false,
    .tx_desc_auto_clear = false,
    .fixed_mclk = 0
  };

  i2s_driver_install(I2S_PORT, &i2s_config, 0, NULL);
}

// ======================================================

void i2s_setpin() {

  const i2s_pin_config_t pin_config = {
    .bck_io_num = I2S_SCK,
    .ws_io_num = I2S_WS,
    .data_out_num = I2S_PIN_NO_CHANGE,
    .data_in_num = I2S_SD
  };

  i2s_set_pin(I2S_PORT, &pin_config);
}

// ======================================================
// OLED GAUGE
// ======================================================

void drawGauge(int value) {

  // Mapping gauge
  int gaugeWidth = map(value, 0, 1500, 0, 120);
  gaugeWidth = constrain(gaugeWidth, 0, 120);

  display.clearDisplay();

  // Title
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(22, 0);
  display.println("SNORE MONITOR");

  // Gauge frame
  display.drawRoundRect(4, 20, 120, 18, 4, WHITE);

  // Gauge fill
  display.fillRoundRect(4, 20, gaugeWidth, 18, 4, WHITE);

  // Value
  display.setCursor(5, 45);
  display.print("Level: ");
  display.print(value);

  // Status
  display.setCursor(5, 56);

  if (value < 80) {
    display.print("QUIET");
  }
  else if (value < 300) {
    display.print("LIGHT SNORE");
  }
  else {
    display.print("HEAVY SNORE");
  }

  display.display();
}

// ======================================================
// SETUP
// ======================================================

void setup() {

  Serial.begin(115200);

  // OLED I2C
  Wire.begin(8, 9);

  // OLED INIT
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {

    Serial.println("OLED gagal");
    
    while (1);
  }

  display.clearDisplay();
  display.display();

  // I2S INIT
  i2s_install();
  i2s_setpin();
  i2s_start(I2S_PORT);

  // Splash screen
  display.setTextSize(2);
  display.setCursor(15, 20);
  display.println("READY");
  display.display();

  delay(1500);
}

// ======================================================
// LOOP
// ======================================================

void loop() {

  size_t bytesIn = 0;

  esp_err_t result = i2s_read(
                      I2S_PORT,
                      &sBuffer,
                      sizeof(sBuffer),
                      &bytesIn,
                      portMAX_DELAY
                    );

  if (result == ESP_OK) {

    int samples_read = bytesIn / 4;

    long total = 0;

    // ==========================================
    // AUDIO PROCESSING
    // ==========================================

    for (int i = 0; i < samples_read; i++) {

      int32_t sample = sBuffer[i];

      // Normalisasi audio
      sample = sample >> 18;

      // Absolut
      sample = abs(sample);

      total += sample;
    }

    long average = total / samples_read;

    // ==========================================
    // NOISE FILTER
    // ==========================================

    if (average < 15)
      average = 0;

    // ==========================================
    // SMOOTHING
    // ==========================================

    filteredLevel = (filteredLevel * 0.85) + (average * 0.15);

    int finalValue = (int)filteredLevel;

    // ==========================================
    // SERIAL
    // ==========================================

    Serial.println(finalValue);

    // ==========================================
    // OLED
    // ==========================================

    drawGauge(finalValue);
  }
}
